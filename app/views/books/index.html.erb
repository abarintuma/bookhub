<section class="books-index">
  <header class="page-header">
    <h1>All Books</h1>
    <p><%= pluralize(@books.count, "book") %> in your collection.</p>
    <%= link_to "Add a new book", new_book_path, class: "btn" %>
  </header>

  <% if @books.any? %>
    <table class="books-table">
      <thead>
        <tr>
          <th>Title</th>
          <th>Author</th>
          <th>Price</th>
          <th>Published On</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @books.each do |book| %>
          <tr>
            <td><%= link_to book.title, book %></td>
            <td><%= book.author %></td>
            <td><%= number_to_currency(book.price) %></td>
            <td><%= book.published_at&.strftime("%B %d, %Y") %></td>
            <td>
              <%= link_to "View", book %> |
              <%= link_to "Edit", edit_book_path(book) %> |
              <%= button_to "Delete", book, method: :delete,
                    data: { turbo_confirm: "Are you sure you want to delete this book?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="empty-state">
      <p>You don't have any books yet.</p>
      <%= link_to "Add your first book", new_book_path, class: "btn" %>
    </div>
  <% end %>
</section>