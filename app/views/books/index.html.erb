<div class="books-index-page">
  <div class="page-header">
    <div>
      <h1 class="page-title">All Books</h1>
      <p class="page-subtitle"><%= pluralize(@books.count, "book") %> registered in your library.</p>
    </div>
    <%= link_to new_book_path, class: "btn btn-primary" do %>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
      <span>Add New Book</span>
    <% end %>
  </div>

  <% if @books.any? %>
    <div class="book-grid">
      <% @books.each do |book| %>
        <div class="book-card">
          <div class="book-card-header">
            <span class="book-cover-placeholder">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
            </span>
            <span class="price-tag"><%= number_to_currency(book.price) %></span>
          </div>

          <div class="book-card-body">
            <h2 class="book-title"><%= link_to book.title, book %></h2>
            <p class="book-author">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
              <span><%= book.author %></span>
            </p>
            <% if book.description.present? %>
              <p class="book-desc"><%= truncate(book.description, length: 110) %></p>
            <% else %>
              <p class="book-desc text-muted">No description provided.</p>
            <% end %>
          </div>

          <div class="book-card-footer">
            <span class="date-badge">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
              <%= book.published_at&.strftime("%b %d, %Y") || "N/A" %>
            </span>

            <div class="card-actions">
              <%= link_to book, class: "btn-icon", title: "View details" do %>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
              <% end %>
              <%= link_to edit_book_path(book), class: "btn-icon btn-icon-edit", title: "Edit book" do %>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
              <% end %>
              <%= button_to book, method: :delete, class: "btn-icon btn-icon-danger", title: "Delete book", data: { turbo_confirm: "Are you sure you want to delete '#{book.title}'?" } do %>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="empty-card">
      <div class="empty-icon">📚</div>
      <h2>No Books in Collection</h2>
      <p>Your library is empty. Click below to add your first book!</p>
      <%= link_to "Add Your First Book", new_book_path, class: "btn btn-primary btn-lg" %>
    </div>
  <% end %>
</div>