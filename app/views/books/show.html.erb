<div class="book-show-page">
  <div class="breadcrumb">
    <%= link_to "← Back to all books", books_path, class: "breadcrumb-link" %>
  </div>

  <article class="detail-card">
    <div class="detail-header">
      <div class="detail-cover">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
      </div>

      <div class="detail-meta-header">
        <h1 class="detail-title"><%= @book.title %></h1>
        <p class="detail-author">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          <span>Written by <strong><%= @book.author %></strong></span>
        </p>
      </div>
    </div>

    <div class="detail-stats-row">
      <div class="detail-stat">
        <span class="detail-stat-label">Price</span>
        <span class="detail-stat-value price-highlight"><%= number_to_currency(@book.price) %></span>
      </div>

      <div class="detail-stat">
        <span class="detail-stat-label">Published On</span>
        <span class="detail-stat-value"><%= @book.published_at&.strftime("%B %d, %Y") || "Date Not Specified" %></span>
      </div>

      <div class="detail-stat">
        <span class="detail-stat-label">Added To Library</span>
        <span class="detail-stat-value"><%= @book.created_at&.strftime("%b %d, %Y") %></span>
      </div>
    </div>

    <div class="detail-body">
      <h2 class="detail-section-title">Description</h2>
      <div class="description-box">
        <% if @book.description.present? %>
          <p><%= simple_format(@book.description) %></p>
        <% else %>
          <p class="text-muted">No description has been added for this book yet.</p>
        <% end %>
      </div>
    </div>

    <div class="detail-actions">
      <%= link_to edit_book_path(@book), class: "btn btn-primary" do %>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
        <span>Edit Book</span>
      <% end %>

      <%= link_to "Back to Books", books_path, class: "btn btn-secondary" %>

      <%= button_to @book, method: :delete, class: "btn btn-danger", data: { turbo_confirm: "Are you sure you want to delete '#{@book.title}'?" } do %>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
        <span>Delete Book</span>
      <% end %>
    </div>
  </article>
</div>