<%= form_with model: book do |f| %>
  <% if book.errors.any? %>
    <div class="error-messages">
      <h2>
        <%= pluralize(book.errors.count, "error") %>
        prohibited this book from being saved:
      </h2>
      <ul>
        <% book.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :title, "Title" %>
    <%= f.text_field :title, placeholder: "Enter the book's title" %>
  </div>

  <div class="field">
    <%= f.label :author, "Author" %>
    <%= f.text_field :author, placeholder: "Enter the author's name" %>
  </div>

  <div class="field">
    <%= f.label :price, "Price (in USD)" %>
    <%= f.number_field :price, step: 0.01, placeholder: "0.00" %>
  </div>

  <div class="field">
    <%= f.label :published_at, "Published Date" %>
    <%= f.date_field :published_at %>
  </div>

  <div class="field">
    <%= f.label :description, "Description" %>
    <%= f.text_area :description, placeholder: "Write a short description..." %>
  </div>

  <div class="actions">
    <%= f.submit "Save Book" %>
  </div>
<% end %>