<%= form_with model: book, class: "custom-form" do |f| %>
  <% if book.errors.any? %>
    <div class="form-error-alert">
      <div class="alert-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
      </div>
      <div>
        <h4 class="alert-title"><%= pluralize(book.errors.count, "error") %> prohibited this book from being saved:</h4>
        <ul class="alert-list">
          <% book.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :title, class: "form-label" do %>
      <span>Title</span> <span class="required-star">*</span>
    <% end %>
    <div class="input-wrapper">
      <span class="input-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
      </span>
      <%= f.text_field :title, class: "form-control", placeholder: "e.g. Design Patterns in Ruby" %>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :author, class: "form-label" do %>
      <span>Author</span> <span class="required-star">*</span>
    <% end %>
    <div class="input-wrapper">
      <span class="input-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
      </span>
      <%= f.text_field :author, class: "form-control", placeholder: "e.g. Russ Olsen" %>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group col">
      <%= f.label :price, class: "form-label" do %>
        <span>Price (USD)</span> <span class="required-star">*</span>
      <% end %>
      <div class="input-wrapper">
        <span class="input-icon">$</span>
        <%= f.number_field :price, step: 0.01, class: "form-control", placeholder: "29.99" %>
      </div>
    </div>

    <div class="form-group col">
      <%= f.label :published_at, "Published Date", class: "form-label" %>
      <div class="input-wrapper">
        <span class="input-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
        </span>
        <%= f.date_field :published_at, class: "form-control" %>
      </div>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :description, "Description", class: "form-label" %>
    <%= f.text_area :description, class: "form-control textarea", rows: 4, placeholder: "Provide a summary, review, or highlights of the book..." %>
  </div>

  <div class="form-actions">
    <%= f.button type: :submit, class: "btn btn-primary btn-lg" do %>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
      <span>Save Book</span>
    <% end %>
  </div>
<% end %>
