<header class="site-header">
  <div class="container navbar-container">
    <div class="navbar-brand">
      <%= link_to root_path, class: "brand-logo" do %>
        <span class="logo-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            <path d="M12 6h4"></path>
            <path d="M12 10h4"></path>
          </svg>
        </span>
        <span class="brand-name">Book<span class="brand-accent">Hub</span></span>
      <% end %>
    </div>

    <nav class="navbar-nav">
      <ul class="nav-list">
        <li class="nav-item"><%= link_to "Home", root_path, class: "nav-link" %></li>
        <li class="nav-item"><%= link_to "All Books", books_path, class: "nav-link" %></li>
        <li class="nav-item"><%= link_to "About", about_path, class: "nav-link" %></li>
      </ul>
      <div class="nav-actions">
        <%= link_to new_book_path, class: "btn btn-primary nav-cta" do %>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          <span>Add Book</span>
        <% end %>
      </div>
    </nav>
  </div>
</header>